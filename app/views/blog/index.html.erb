<%
  page_title = 'Blog: Government Tenders, Procurement & Business Guides'
  page_desc  = 'Guides and insights on government tenders in India, e-procurement, bidding strategy, project reports and materials from the SigmaTenders team.'
  canonical  = "#{site_base_url}#{blog_index_path}"
  set_meta_tags(
    title: 'SigmaTenders Blog',
    description: page_desc,
    canonical: canonical,
    og: { title: page_title, type: 'website', url: canonical, description: page_desc, site_name: 'Sigma Tenders' },
    twitter: { card: 'summary', title: page_title, description: page_desc }
  )
%>

<%= render 'layouts/navbar' %>

<div class="bg-gray-50 min-h-screen">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">SigmaTenders Blog</h1>
      <p class="mt-3 text-lg text-gray-600">Guides on government tenders, procurement and growing your business with public contracts.</p>
    </header>

    <% if @posts.empty? %>
      <p class="text-gray-600">No posts yet.</p>
    <% else %>
      <div class="space-y-6">
        <% @posts.each do |post| %>
          <article class="bg-white rounded-lg border border-gray-200 p-6 hover:border-orange-300">
            <p class="text-sm text-gray-500">
              <time datetime="<%= post.pub_date.iso8601 %>"><%= post.pub_date.strftime('%-d %B %Y') %></time>
              · <%= post.reading_minutes %> min read
              <% if post.tags.any? %> · <%= post.tags.join(', ') %><% end %>
            </p>
            <h2 class="mt-2 text-xl font-semibold text-gray-900">
              <a href="<%= blog_post_path(post) %>" class="hover:text-orange-700"><%= post.title %></a>
            </h2>
            <p class="mt-2 text-gray-600 leading-relaxed"><%= post.summary(220) %></p>
            <a href="<%= blog_post_path(post) %>" class="mt-3 inline-block text-sm font-semibold text-orange-700 hover:underline">Read more →</a>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%= render 'layouts/footer' %>
