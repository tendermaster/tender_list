<!DOCTYPE html>
<html>
<head>
  <%= display_meta_tags site: "Sigma Tenders" %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv='content-language' content='en-US'>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= render 'layouts/google' %>
  <%= javascript_importmap_tags %>
  <%# vendored UMD builds (vendor/javascript), versions in the file names %>
  <%= javascript_include_tag "flowbite-4.0.2.min", "jquery-3.7.1.min", "sweetalert2-11.26.25.all.min" %>

  <link href="/opensearch.xml" rel="search" title="SigmaTenders Search" type="application/opensearchdescription+xml">

  <%# chatbot %>
  <script type="text/javascript">window.$crisp=[];window.CRISP_WEBSITE_ID="1bfc6f0a-0b99-4990-8a9a-6463a364d55d";(function(){d=document;s=d.createElement("script");s.src="https://client.crisp.chat/l.js";s.async=1;d.getElementsByTagName("head")[0].appendChild(s);})();</script>
</head>

<%# Google One Tap for logged-out visitors (google_sign_in_controller.js) %>
<% if user_signed_in? || request.path.start_with?('/admin') %>
<body class="">
<% else %>
<body class="" data-controller="google-sign-in"
      data-google-sign-in-client-id-value="<%= ENV['GOOGLE_CLIENT_ID'] %>"
      data-google-sign-in-url-value="<%= user_google_sign_in_path %>"
      data-google-sign-in-return-here-value="<%= !request.path.start_with?('/users') %>">
<% end %>

<main class="">
<!--  <p class="notice"><%#= notice %></p>-->
<!--  <p class="alert"><%#= alert %></p>-->
  <%= yield %>
</main>
</body>
</html>
