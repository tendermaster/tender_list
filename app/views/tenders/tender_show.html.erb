<%
  canonical_url = "#{site_base_url}/tender/#{@tender_data.slug_uuid}"
  formatted_title = @tender_data.title.to_s.titleize
  formatted_desc = "#{formatted_title.truncate(140)}. Organisation: #{@tender_data.organisation}. Location: #{@tender_data.state || 'India'}. Closing Date: #{@tender_data.submission_close_date&.strftime('%d-%b-%Y') || 'N/A'}."
  
  set_meta_tags(
    title: formatted_title,
    description: formatted_desc,
    keywords: "sigma tenders, #{@tender_data.title.to_s.downcase}, #{@tender_data.organisation.to_s.downcase} tenders, #{@tender_data.state.to_s.downcase} tenders, india e-tenders",
    canonical: canonical_url,
    og: {
      title: formatted_title,
      type: "website",
      url: canonical_url,
      description: formatted_desc,
      site_name: "Sigma Tenders"
    },
    twitter: {
      card: "summary",
      title: formatted_title,
      description: formatted_desc
    }
  )
  is_expired = @tender_data.submission_close_date.present? && @tender_data.submission_close_date < Time.current

  demand_schema = {
    "@type" => "Demand",
    "@id" => "#{canonical_url}#demand",
    "name" => formatted_title,
    "description" => @tender_data.description.presence || formatted_desc,
    "businessFunction" => "http://purl.org/goodrelations/v1#Buy",
    "identifier" => @tender_data.tender_reference_number.presence || @tender_data.tender_id,
    "seller" => {
      "@type" => "GovernmentOrganization",
      "name" => @tender_data.organisation.presence || "Government Department"
    },
    "areaServed" => {
      "@type" => "AdministrativeArea",
      "name" => @tender_data.state.presence || "India"
    },
    "validFrom" => @tender_data.submission_open_date&.iso8601,
    "validThrough" => @tender_data.submission_close_date&.iso8601,
    "availability" => is_expired ? "https://schema.org/Discontinued" : "https://schema.org/InStock",
    "url" => canonical_url
  }

  if @tender_data.tender_value.present? && @tender_data.tender_value.to_i > 0
    demand_schema["priceSpecification"] = {
      "@type" => "PriceSpecification",
      "price" => @tender_data.tender_value.to_s,
      "priceCurrency" => "INR",
      "validThrough" => @tender_data.submission_close_date&.iso8601
    }.compact
  end

  government_service_schema = {
    "@type" => "GovernmentService",
    "@id" => "#{canonical_url}#service",
    "name" => formatted_title,
    "description" => @tender_data.description.presence || formatted_desc,
    "serviceType" => "Public Tender & E-Procurement",
    "provider" => {
      "@type" => "GovernmentOrganization",
      "name" => @tender_data.organisation.presence || "Government Department"
    },
    "serviceOperator" => {
      "@type" => "GovernmentOrganization",
      "name" => @tender_data.organisation.presence || "Government Department"
    },
    "areaServed" => {
      "@type" => "AdministrativeArea",
      "name" => @tender_data.state.presence || "India"
    },
    "validThrough" => @tender_data.submission_close_date&.iso8601,
    "url" => canonical_url
  }

  # Home › State tenders › this tender; the state step only for real states
  # (it linked to /tenders-by-state/<anything>, which doesn't exist)
  state_path = state_tenders_path(@tender_data.state)
  breadcrumb_schema = {
    "@type" => "BreadcrumbList",
    "@id" => "#{canonical_url}#breadcrumb",
    "itemListElement" => [
      { "name" => "Home", "item" => site_base_url },
      ({ "name" => "#{@tender_data.state.squish} Tenders", "item" => "#{site_base_url}#{state_path}" } if state_path),
      { "name" => formatted_title.truncate(45), "item" => canonical_url }
    ].compact.each_with_index.map { |crumb, i| { "@type" => "ListItem", "position" => i + 1 }.merge(crumb) }
  }

  json_ld_graph = {
    "@context" => "https://schema.org",
    "@graph" => [
      demand_schema.compact,
      government_service_schema.compact,
      breadcrumb_schema
    ]
  }
%>

<script type="application/ld+json">
<%= raw(json_ld_graph.to_json) %>
</script>

<%= render 'layouts/navbar' %>

<%
  days_left = time_left(@tender_data.submission_close_date)
  tender_status =
    if days_left.nil?
      { label: "Date unavailable", class: "bg-gray-100 text-gray-700 border-gray-200" }
    elsif days_left.negative?
      { label: "Expired", class: "bg-red-100 text-red-700 border-red-200" }
    elsif days_left <= 3
      { label: "Closing soon", class: "bg-orange-100 text-orange-700 border-orange-200" }
    else
      { label: "Open", class: "bg-green-100 text-green-700 border-green-200" }
    end

%>

<div class="text-gray-800 lg:pt-2 xl:px-36">
  <!--header-->

  <!-- content -->
  <div class="mx-8 my-12">

    <div class="">

      <div class="mt-6">
        <%= render partial: 'tender_search', locals: {
          query: ''
        } %>
      </div>

      <div class="flex items-center">
        <h3 class="my-8 text-xl font-semibold">Tender Details</h3>
        <div class="ml-4">
          <%= render 'tenders/bookmark_button', tender: @tender_data, saved: tender_bookmarked?(current_user&.id, @tender_data.id) %>
        </div>
      </div>

      <% closed = days_left&.negative? %>
      <% open_similar = (@similar_tenders || []).count { |t| t.submission_close_date&.future? } %>
      <% if closed %>
        <%= render 'tenders/closed_banner', tender: @tender_data, open_similar: open_similar,
                   result: (@tender_data.bid_winner.present? ? :winner : (:details if @bid_result)) %>
      <% end %>

      <div class="lg:grid grid-cols-12 gap-x-8">
        <div class="relative col-span-8 overflow-x-auto">
          <% if !@tender_data.short_blog.nil? %>
            <div class="px-4 mb-8 prose whitespace-pre-line text-center">
              <h2 class="text-lg">About Tender</h2>
              <%= @tender_data.short_blog.titleize %>
            </div>
          <% end %>
          <table
            class="w-full overflow-hidden text-left text-sm text-gray-500 dark:text-gray-400 sm:rounded-lg"
          >
            <thead
              class="hidden sm:table-header-group bg-gray-50 text-xs uppercase text-gray-700 dark:bg-gray-700 dark:text-gray-400"
            >
            <tr>
              <th scope="col" class="py-3 px-6">Particulars</th>
              <th scope="col" class="py-3 px-6">Details</th>
            </tr>
            </thead>
            <tbody class="block sm:table-row-group">
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Title
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6 select-none">
                <% if User.can_fully_view_tender(current_user, @tender_data.submission_close_date) || !is_tender_id?(@tender_data.title) %>
                  <% if User.active_plan(current_user) === 'PAID' %>
                    <div class="select-text">
                      <%= @tender_data.title&.titleize %>
                    </div>
                  <% else %>
                    <div><%= @tender_data.title&.titleize %></div>
                  <% end %>
	                <% else %>
	                  <%= render 'plan_to_view_tender', label: 'Unlock tender title' %>
	                <% end %>
              </td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Description
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6 select-none">
                <% if User.active_plan(current_user) == 'PAID' %>
                  <div class="select-text">
                    <%= @tender_data.description&.titleize %>
                  </div>
                <% else %>
                  <div>
                    <%= @tender_data.description&.titleize %>
                  </div>
                <% end %>
              </td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Organisation
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6"><%= @tender_data.organisation %></td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Tender Id
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6">
                <% if User.can_fully_view_tender(current_user, @tender_data.submission_close_date) %>
                  <%= @tender_data.tender_id %>
	                <% else %>
	                  <%= render 'plan_to_view_tender', label: 'Unlock tender ID' %>
	                <% end %>
              </td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Reference <br> Number
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6">
                <% if User.can_fully_view_tender(current_user, @tender_data.submission_close_date) %>
                  <%= @tender_json&.dig('TenderReferenceNumber') || @tender_data.tender_reference_number || '-' %>
	                <% else %>
	                  <%= render 'plan_to_view_tender', label: 'Unlock reference number' %>
	                <% end %>
              </td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Tender Fee
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6"><%= currency_format(@tender_data.tender_fee) %></td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                EMD
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6"><%= currency_format(@tender_data.emd) %></td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Tender Value
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6"><%= currency_format(@tender_data.tender_value) %></td>
            </tr>
            <!--              <tr-->
            <!--                class="border-b bg-white dark:border-gray-700 dark:bg-gray-800"-->
            <!--              >-->
            <!--                <th-->
            <!--                  scope="row"-->
            <!--                  class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"-->
            <!--                >-->
            <!--                  Time Period-->
            <!--                </th>-->
            <!--                <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6">730d</td>-->
            <!--              </tr>-->
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Place
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6"><%= @tender_data.state %></td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Link
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6">
	                <% if User.can_fully_view_tender(current_user, @tender_data.submission_close_date) %>
	                  <div class="min-w-0">
	                    <a class="inline-flex items-center rounded-md bg-blue-50 px-3 py-2 font-semibold text-blue-700 hover:bg-blue-100" target="_blank" rel="nofollow noopener noreferrer" href="<%= @tender_data.page_link %>">
	                      View Original Tender Notice
	                      <svg class="ml-2 h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
	                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M6 18h10.5A1.5 1.5 0 0 0 18 16.5v-3M6 18A1.5 1.5 0 0 1 4.5 16.5v-9A1.5 1.5 0 0 1 6 6h3" />
	                      </svg>
	                    </a>
	                    <p class="mt-2 text-xs text-gray-500 force-word-break"><%= @tender_data.page_link %></p>
	                  </div>
	                <% else %>
	                  <%= render 'plan_to_view_tender', label: 'Unlock original tender link' %>
	                <% end %>
              </td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                Start Date
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6"><%= @tender_data.submission_open_date&.in_time_zone("Asia/Kolkata")&.to_formatted_s(:long) || '-' %></td>
            </tr>
            <tr
              class="block sm:table-row border-b bg-white dark:border-gray-700 dark:bg-gray-800"
            >
              <th
                scope="row"
                class="block sm:table-cell whitespace-nowrap px-4 pt-3 pb-1 sm:py-4 sm:px-6 font-medium text-gray-900 dark:text-white"
              >
                End Date
              </th>
              <td class="block sm:table-cell px-4 pb-3 sm:py-4 sm:px-6 <%= days_left.nil? ? 'bg-gray-50' : days_left >= 0 ? 'bg-green-50' : 'bg-red-50' %>">
                <div class="md:flex md:items-center md:justify-between gap-4">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold <%= tender_status[:class] %>"><%= tender_status[:label] %></span>
                      <span class="font-medium text-gray-900"><%= @tender_data.submission_close_date&.strftime("%d/%m/%Y") || '-' %></span>
                    </div>
                    <p class="mt-1 text-sm text-gray-600"><%= time_left_text(@tender_data.submission_close_date) %></p>
                  </div>
                  <a class="btn-sm inline-block whitespace-nowrap mt-2 md:mt-0 md:ml-10" href="#similar-tenders">Similar tenders</a>
                </div>
              </td>
            </tr>
            </tbody>
          </table>

          <%= render 'tenders/bid_actions', tender: @tender_data, open: !days_left&.negative? %>

          <div>
            <!-- Corrigenda and Amendments -->
            <%= render 'tenders/partials/corrigendums' %>

            <!-- Tender Bid Results & Awards -->
            <% if @bid_result %>
              <%= render 'tenders/partials/tender_results' %>
            <% end %>
          </div>


	        </div>

        <%# Phones: details, then this, then similar tenders. Desktop: beside both %>
        <div class="col-span-4 mt-10 lg:row-span-2 lg:mt-0 lg:self-start">
          <% if closed %>
            <%= render 'get_relevant_tenders_form', keywords: tender_topic(@tender_data),
                       heading: 'Get alerts for tenders like this',
                       intro: "This one has closed. Tell us what you supply and we'll send you new tenders like it." %>
          <% else %>
            <%= render 'tenders/partner_card', tender: @tender_data %>
            <%= render 'get_relevant_tenders_form' %>
          <% end %>
        </div>

        <div id="similar-tenders" class="col-span-8 scroll-mt-6">
          <h2 class="mt-10 mb-4 text-lg font-bold text-gray-900"><%= closed && open_similar.positive? ? 'Open tenders like this' : 'Similar Tenders' %></h2>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <% (@similar_tenders || []).each_with_index do |tender, index| %>
              <% title = tender.title.to_s.squish %>
              <% description = tender.description.to_s.squish %>
              <li class="<%= 'max-lg:hidden' if index >= 4 %> flex flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-xs dark:border-gray-700 dark:bg-gray-800">
                <%# no perm needed to only view title %>
                <% if User.can_fully_view_tender(current_user, tender.submission_close_date) || !is_tender_id?(tender.title) %>
                  <h3 class="line-clamp-3 font-semibold leading-snug text-gray-900 dark:text-white">
                    <%= link_to title.capitalize, tender_show_path(tender.slug_uuid), class: 'hover:text-orange-700' %>
                  </h3>
                <% else %>
                  <div class="flex"><%= render 'plan_to_view_tender', label: 'Unlock tender title' %></div>
                <% end %>
                <%# The description often repeats the title: only when it adds something %>
                <% unless description.blank? || description.downcase.start_with?(title.downcase.first(40)) %>
                  <p class="mt-2 line-clamp-3 text-sm text-gray-600 dark:text-gray-400"><%= description.capitalize %></p>
                <% end %>
                <p class="mt-3 text-xs text-gray-500">
                  <span class="line-clamp-2"><%= [tender.organisation.presence, tender.state.presence].compact.join(' · ') %></span>
                  <% if tender.submission_close_date&.future? %>
                    <span class="block mt-0.5">Closes <%= tender.submission_close_date.strftime('%d/%m/%Y') %></span>
                  <% elsif tender.submission_close_date %>
                    <span class="block mt-0.5 text-red-700">Closed <%= tender.submission_close_date.strftime('%d/%m/%Y') %></span>
                  <% end %>
                </p>
                <%= link_to tender_show_path(tender.slug_uuid), class: 'mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-orange-700 hover:underline' do %>
                  View tender <span aria-hidden="true">→</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>


  </div>
</div>

<%= render 'layouts/footer' %>

<!--<div class="bg-sky-900 text-white">s</div>-->
