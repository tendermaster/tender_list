<%
  canonical_url = "#{site_base_url}/tender/#{@tender_data.slug_uuid}"
  formatted_title = @tender_data.title.to_s.titleize
  formatted_desc = "#{formatted_title.truncate(140)}. Organisation: #{@tender_data.organisation}. Location: #{@tender_data.state || 'India'}. Closing Date: #{@tender_data.submission_close_date&.strftime('%d-%b-%Y') || 'N/A'}."
  
  set_meta_tags(
    title: formatted_title,
    description: formatted_desc,
    keywords: "sigma tenders, #{@tender_data.title.to_s.downcase}, #{@tender_data.organisation.to_s.downcase} tenders, #{@tender_data.state.to_s.downcase} tenders, india e-tenders",
    canonical: canonical_url,
    og: {
      title: formatted_title,
      type: "website",
      url: canonical_url,
      description: formatted_desc,
      site_name: "Sigma Tenders"
    },
    twitter: {
      card: "summary",
      title: formatted_title,
      description: formatted_desc
    }
  )
  is_expired = @tender_data.submission_close_date.present? && @tender_data.submission_close_date < Time.current

  demand_schema = {
    "@type" => "Demand",
    "@id" => "#{canonical_url}#demand",
    "name" => formatted_title,
    "description" => @tender_data.description.presence || formatted_desc,
    "businessFunction" => "http://purl.org/goodrelations/v1#Buy",
    "identifier" => @tender_data.tender_reference_number.presence || @tender_data.tender_id,
    "seller" => {
      "@type" => "GovernmentOrganization",
      "name" => @tender_data.organisation.presence || "Government Department"
    },
    "areaServed" => {
      "@type" => "AdministrativeArea",
      "name" => @tender_data.state.presence || "India"
    },
    "validFrom" => @tender_data.submission_open_date&.iso8601,
    "validThrough" => @tender_data.submission_close_date&.iso8601,
    "availability" => is_expired ? "https://schema.org/Discontinued" : "https://schema.org/InStock",
    "url" => canonical_url
  }

  if @tender_data.tender_value.present? && @tender_data.tender_value.to_i > 0
    demand_schema["priceSpecification"] = {
      "@type" => "PriceSpecification",
      "price" => @tender_data.tender_value.to_s,
      "priceCurrency" => "INR",
      "validThrough" => @tender_data.submission_close_date&.iso8601
    }.compact
  end

  government_service_schema = {
    "@type" => "GovernmentService",
    "@id" => "#{canonical_url}#service",
    "name" => formatted_title,
    "description" => @tender_data.description.presence || formatted_desc,
    "serviceType" => "Public Tender & E-Procurement",
    "provider" => {
      "@type" => "GovernmentOrganization",
      "name" => @tender_data.organisation.presence || "Government Department"
    },
    "serviceOperator" => {
      "@type" => "GovernmentOrganization",
      "name" => @tender_data.organisation.presence || "Government Department"
    },
    "areaServed" => {
      "@type" => "AdministrativeArea",
      "name" => @tender_data.state.presence || "India"
    },
    "validThrough" => @tender_data.submission_close_date&.iso8601,
    "url" => canonical_url
  }

  # Home › State tenders › this tender; the state step only for real states
  # (it linked to /tenders-by-state/<anything>, which doesn't exist)
  state_path = state_tenders_path(@tender_data.state)
  breadcrumb_schema = {
    "@type" => "BreadcrumbList",
    "@id" => "#{canonical_url}#breadcrumb",
    "itemListElement" => [
      { "name" => "Home", "item" => site_base_url },
      ({ "name" => "#{@tender_data.state.squish} Tenders", "item" => "#{site_base_url}#{state_path}" } if state_path),
      { "name" => formatted_title.truncate(45), "item" => canonical_url }
    ].compact.each_with_index.map { |crumb, i| { "@type" => "ListItem", "position" => i + 1 }.merge(crumb) }
  }

  json_ld_graph = {
    "@context" => "https://schema.org",
    "@graph" => [
      demand_schema.compact,
      government_service_schema.compact,
      breadcrumb_schema
    ]
  }
%>

<script type="application/ld+json">
<%= raw(json_ld_graph.to_json) %>
</script>


<%= render 'layouts/navbar' %>

<%
  # Most visitors arrive from a search engine, and about three in four land on
  # a tender that has closed. An open tender leads with help filing the bid; a
  # closed one with open tenders like it and alerts for new ones.
  days_left = time_left(@tender_data.submission_close_date)
  closed = days_left&.negative?
  unlocked = User.can_fully_view_tender(current_user, @tender_data.submission_close_date)
  similar = (@similar_tenders || []).sort_by { |t| t.submission_close_date&.future? ? 0 : 1 }
  open_similar = similar.count { |t| t.submission_close_date&.future? }
  result = @tender_data.bid_winner.present? ? :winner : (:details if @bid_result)
  # A closed tender shows the first few similar ones at the top, the rest below
  top_similar = closed && open_similar.positive? ? similar.first([open_similar, 4].min) : []
  rest_similar = similar - top_similar
%>

<main class="mx-auto max-w-6xl px-4 pt-6 pb-12 text-gray-800 sm:px-6 dark:text-gray-200">
  <% if state_path %>
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-gray-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><%= link_to 'Home', root_path, class: 'hover:text-orange-700' %></li>
        <li aria-hidden="true">›</li>
        <li><%= link_to "#{@tender_data.state.squish} tenders", state_path, class: 'hover:text-orange-700' %></li>
      </ol>
    </nav>
  <% end %>

  <%= render 'tenders/tender_header', tender: @tender_data, days_left: days_left, unlocked: unlocked %>

  <% if closed %>
    <%= render 'tenders/closed_banner', tender: @tender_data, open_similar: open_similar, result: result %>
  <% end %>

  <div class="mt-6 lg:grid lg:grid-cols-12 lg:gap-x-8">
    <%# Phones show these in source order: top, sidebar, bottom %>
    <div class="col-span-8">
      <% if closed %>
        <% if top_similar.any? %>
          <%= render 'tenders/similar_tenders', tenders: top_similar, id: 'similar-tenders', heading: 'Open tenders like this', top: true %>
        <% end %>
      <% else %>
        <%= render 'tenders/bid_actions', tender: @tender_data, open: true, url: canonical_url %>
        <%= render 'tenders/tender_details', tender: @tender_data, unlocked: unlocked %>
      <% end %>
    </div>

    <aside class="col-span-4 mt-8 lg:row-span-2 lg:mt-0 lg:self-start">
      <% if closed %>
        <%= render 'get_relevant_tenders_form', keywords: tender_topic(@tender_data), tender: @tender_data,
                   heading: 'Get tenders like this',
                   intro: "This one has closed. Tell us what you supply: we'll send you new tenders like it on WhatsApp and call you about them." %>
      <% else %>
        <%= render 'tenders/partner_card', tender: @tender_data %>
        <%= render 'get_relevant_tenders_form', tender: @tender_data %>
      <% end %>
    </aside>

    <div class="col-span-8">
      <% if closed %>
        <%# Details, who won, getting ready for the next one; the old corrigenda last %>
        <%= render 'tenders/tender_details', tender: @tender_data, unlocked: unlocked %>
        <%= render 'tenders/partials/tender_results' if @bid_result %>
        <%= render 'tenders/bid_actions', tender: @tender_data, open: false, url: canonical_url %>
        <%= render 'tenders/partials/corrigendums' %>
      <% else %>
        <%= render 'tenders/partials/corrigendums' %>
        <%= render 'tenders/partials/tender_results' if @bid_result %>
      <% end %>

      <% if rest_similar.any? %>
        <%= render 'tenders/similar_tenders', tenders: rest_similar, id: (top_similar.any? ? 'more-tenders' : 'similar-tenders'),
                   heading: top_similar.any? ? 'More tenders like this' : 'Similar tenders' %>
      <% end %>

      <section class="mt-12" aria-label="Search tenders">
        <h2 class="mb-3 text-lg font-bold text-gray-900 dark:text-white">Search other tenders</h2>
        <%= render partial: 'tender_search', locals: { query: '' } %>
      </section>
    </div>
  </div>
</main>

<%= render 'tenders/mobile_action_bar', tender: @tender_data, closed: closed, url: canonical_url %>

<%= render 'layouts/footer' %>
<%# Room for the phone action bar under the footer %>
<div class="h-16 lg:hidden"></div>
