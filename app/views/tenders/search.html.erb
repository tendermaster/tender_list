<%
  is_keyword_page = params[:keyword].present?
  has_results = @records.present?

  canonical_url = if is_keyword_page
    "#{site_base_url}/tenders/#{params[:keyword]}-tenders"
  else
    "#{site_base_url}/search?q=#{CGI.escape(@query_label.to_s)}"
  end

  meta_title = if has_results
    "#{@pagy.count} #{@query_label} in India - #{Date.today.year}".titleize
  else
    "#{@query_label} Tenders in India - Search & Alerts (#{Date.today.year})".titleize
  end

  meta_desc = if has_results
    "Find the latest #{@query_label} tenders in India. Access tender documents, BOQs, and online bidding details on Sigma Tenders."
  else
    "Search and receive daily email alerts for #{@query_label} tenders in India across central, state government, GeM, and PSU portals."
  end

  # Industry standard SEO rule:
  # - If programmatic keyword landing page (/tenders/:keyword-tenders): keep 'index, follow' (displays recommendations/archive).
  # - If raw user search with 0 hits (/search?q=...): use 'noindex, follow' to prevent Soft-404 and crawl budget waste.
  robots_directive = if is_keyword_page || has_results
    'index, follow'
  else
    'noindex, follow'
  end

  set_meta_tags(
    title: meta_title,
    description: meta_desc,
    keywords: "#{@query_label}, tenders, #{@query_label} tenders in India, #{@query_label} e-tenders",
    canonical: canonical_url,
    robots: robots_directive,
    og: {
      title: meta_title,
      description: meta_desc,
      url: canonical_url,
      type: "website",
      site_name: "Sigma Tenders"
    },
    twitter: {
      card: "summary",
      title: meta_title,
      description: meta_desc
    }
  )
%>

<%= render 'layouts/navbar' %>

<div class="container-home py-12 mb-12">
  <!-- search bar -->
  <div class="mt-6">
    <%= render partial: 'tenders/tender_search', locals: {
      query: @query_label
    } %>
  </div>

  <!-- search result heading -->
  <div class="hidden">
    <%= @query %>
  </div>
  <% if params[:onboarded] && user_signed_in? %>
    <%# Arrived from onboarding (/welcome) %>
    <div class="mt-6 rounded-lg bg-green-50 px-4 py-3 text-green-800" id="notice">
      <p class="font-semibold"><%= number_with_delimiter(@pagy.count) %> tenders match what you bid on.</p>
      <p class="text-sm">Thanks! Our team will call you on <%= current_user.phone %>. Change your keywords any time in <%= link_to 'My searches', queries_path, class: 'underline' %>.</p>
    </div>
    <script>window.gtag?.("event", "onboarding_complete")</script>
  <% end %>
  <h1 class="my-4 text-xl font-bold">Results for: <%= @query_label %></h1>
  <h2 class="mt-4 mb-8 text-sm font-bold text-gray-700 dark:text-gray-300">
    Find the latest <%= @query_label %> tenders from different organizations. SigmaTenders helps you participate in these online e-Procurement tenders. We provide access to tender details, BOQs, and technical bids, along with bidding support for <%= @query_label %> e-tenders. Stay informed with daily email alerts and comprehensive coverage across government websites, GeM, and e-Procurement portals.
  </h2>

  <div class="lg:grid grid-cols-12 gap-x-8">
    <div class="results space-y-6 col-span-8">
      <% if @records.present? %>
        <% @records.each do |result| %>
          <%= render partial: 'tenders/tender_card', locals: { result: result } %>
        <% end %>
      <% else %>
        <%= render 'tenders/zero_result_fallback' %>
      <% end %>
    </div>
    
    <div class="col-span-4 mt-10 lg:mt-0">
      <div class="mb-6 rounded-lg border border-orange-200 bg-orange-50 p-5 dark:border-gray-700 dark:bg-gray-800">
        <h3 class="text-base font-semibold text-gray-900 dark:text-white">Need support responding to this opportunity?</h3>
        <p class="mt-2 text-sm leading-6 text-gray-700 dark:text-gray-300">Get matched through GetSaarthi for documentation, proposal preparation, compliance readiness, and execution support.</p>
        <a href="<%= getsaarthi_opportunity_matching_url(medium: 'search_results', campaign: 'opportunity_matching') %>" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex w-full justify-center rounded-lg bg-orange-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-orange-700 focus:outline-hidden focus:ring-4 focus:ring-orange-200">
          Get Opportunity Matching Support
        </a>
      </div>
      <%= render "tenders/get_relevant_tenders_form" %>
    </div>
  </div>

  <!-- pagination (only shown when results span multiple pages) -->
  <% if @pagy.count > @pagy.items %>
    <%= render 'layouts/pagy' %>
  <% end %>
</div>

<%= render 'layouts/footer' %>
