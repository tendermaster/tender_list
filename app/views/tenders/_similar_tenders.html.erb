<%# A list of tenders like this one. locals: tenders, id, heading, top (at
    the top of a closed tender's page, without the margin above) %>
<section id="<%= id %>" class="<%= 'mt-10' unless local_assigns[:top] %> scroll-mt-6">
  <h2 class="mb-4 text-lg font-bold text-gray-900 dark:text-white"><%= heading %></h2>
  <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <% tenders.each_with_index do |tender, index| %>
      <% title = tender.title.to_s.squish %>
      <% description = tender.description.to_s.squish %>
      <li class="<%= 'max-lg:hidden' if index >= 4 %> flex flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-xs dark:border-gray-700 dark:bg-gray-800">
        <% if User.can_fully_view_tender(current_user, tender.submission_close_date) || !is_tender_id?(tender.title) %>
          <h3 class="line-clamp-3 font-semibold leading-snug text-gray-900 dark:text-white">
            <%= link_to tender_card_heading(tender), tender_show_path(tender.slug_uuid), class: 'hover:text-orange-700' %>
          </h3>
        <% else %>
          <h3 class="font-semibold leading-snug text-gray-900 dark:text-white">
            <%= link_to "Tender from #{tender.organisation.presence || 'a government department'}", tender_show_path(tender.slug_uuid), class: 'hover:text-orange-700' %>
          </h3>
        <% end %>
        <%# The description often repeats the title: only when it adds something %>
        <% unless description.blank? || description.downcase.start_with?(title.downcase.first(40)) || tender_card_heading(tender) == tender_text(description) %>
          <p class="mt-2 line-clamp-3 text-sm text-gray-600 dark:text-gray-400"><%= tender_text(description) %></p>
        <% end %>
        <p class="mt-3 text-xs text-gray-500">
          <span class="line-clamp-2"><%= [tender.organisation.presence, tender.state.presence].compact.join(' · ') %></span>
          <% if tender.submission_close_date&.future? %>
            <span class="mt-0.5 block font-medium text-green-700">Closes <%= tender.submission_close_date.strftime('%-d %b %Y') %></span>
          <% elsif tender.submission_close_date %>
            <span class="mt-0.5 block text-red-700">Closed <%= tender.submission_close_date.strftime('%-d %b %Y') %></span>
          <% end %>
        </p>
        <%= link_to tender_show_path(tender.slug_uuid), class: 'mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-orange-700 hover:underline' do %>
          View tender <span aria-hidden="true">→</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
