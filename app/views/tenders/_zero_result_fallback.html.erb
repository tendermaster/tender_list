<div class="space-y-8">
  <!-- 0-Result Alert & Lead Capture Box -->
  <div class="rounded-xl border-2 border-dashed border-orange-300 bg-orange-50/70 p-6 dark:border-gray-700 dark:bg-gray-800">
    <div class="flex items-start gap-4">
      <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-orange-100 text-orange-600 dark:bg-orange-900/30">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
      </div>
      <div class="flex-1">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">
          No live tenders matching "<%= @query_label %>" today
        </h3>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
          Government tenders for <strong><%= @query_label %></strong> are published regularly across 200+ central, state, GeM, and PSU portals. Get alerted the moment new tenders go live!
        </p>

        <!-- Quick Alert Subscription Form -->
        <form action="/get-relevant-tenders" method="post" class="mt-4 flex flex-col sm:flex-row gap-3">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
          <input type="hidden" name="sectors" value="<%= @query_label %>" />
          <input 
            type="email" 
            name="email" 
            required="required" 
            placeholder="Enter your work email for <%= @query_label %> alerts"
            class="block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-900 focus:border-orange-500 focus:ring-orange-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white"
          />
          <button 
            type="submit" 
            class="inline-flex flex-shrink-0 items-center justify-center rounded-lg bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-orange-700 focus:outline-none focus:ring-4 focus:ring-orange-300"
          >
            Get Free Alerts
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Helpful Search Suggestions -->
  <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
    <h4 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2">
      <svg class="h-4 w-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Search Tips to Find More Tenders:
    </h4>
    <ul class="mt-2.5 list-disc pl-5 text-sm text-gray-600 dark:text-gray-300 space-y-1">
      <li>Try using broader terms (e.g. search <em>"Civil"</em> instead of <em>"Civil road work in ward 4"</em>).</li>
      <li>Check for alternative keywords or abbreviations (e.g. <em>"Solar"</em>, <em>"CCTV"</em>, <em>"Manpower"</em>).</li>
      <li>Search by authority or state (e.g. <em>"CPWD"</em>, <em>"Maharashtra"</em>, <em>"BHEL"</em>, <em>"GeM"</em>).</li>
    </ul>
  </div>

  <!-- Fallback: Active Trending Tenders -->
  <% if @fallback_tenders.present? %>
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">
          🔥 Trending Active Tenders in India
        </h3>
        <span class="text-xs font-medium text-gray-500">Live Opportunities</span>
      </div>
      
      <div class="space-y-6">
        <% @fallback_tenders.each do |result| %>
          <%= render partial: 'tenders/tender_card', locals: { result: result } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
