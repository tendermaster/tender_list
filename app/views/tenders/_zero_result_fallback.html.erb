<div class="space-y-8">
  <%= render 'tenders/get_relevant_tenders_form', keywords: @query_label,
             heading: "No live tenders matching “#{@query_label}” today",
             intro: "They're published regularly across 200+ central, state, GeM and PSU portals. Leave your details and we'll alert you when new ones go live." %>

  <!-- Helpful Search Suggestions -->
  <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-xs dark:border-gray-700 dark:bg-gray-800">
    <h4 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2">
      <svg class="h-4 w-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Search Tips to Find More Tenders:
    </h4>
    <ul class="mt-2.5 list-disc pl-5 text-sm text-gray-600 dark:text-gray-300 space-y-1">
      <li>Try using broader terms (e.g. search <em>"Civil"</em> instead of <em>"Civil road work in ward 4"</em>).</li>
      <li>Check for alternative keywords or abbreviations (e.g. <em>"Solar"</em>, <em>"CCTV"</em>, <em>"Manpower"</em>).</li>
      <li>Search by authority or state (e.g. <em>"CPWD"</em>, <em>"Maharashtra"</em>, <em>"BHEL"</em>, <em>"GeM"</em>).</li>
    </ul>
  </div>

  <!-- Fallback: Active Trending Tenders -->
  <% if @fallback_tenders.present? %>
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">
          🔥 Trending Active Tenders in India
        </h3>
        <span class="text-xs font-medium text-gray-500">Live Opportunities</span>
      </div>
      
      <div class="space-y-6">
        <% @fallback_tenders.each do |result| %>
          <%= render partial: 'tenders/tender_card', locals: { result: result } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
