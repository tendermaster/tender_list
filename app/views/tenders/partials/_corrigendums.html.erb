<% if @tender_data.has_corrigendum? %>
  <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-5 shadow-sm">
    <div class="flex items-center gap-2 mb-3">
      <span class="flex h-3 w-3 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-amber-500"></span>
      </span>
      <h4 class="text-base font-bold text-amber-900">
        Corrigenda & Amendments (<%= @tender_data.corrigendums.size %>)
      </h4>
    </div>
    
    <p class="text-xs text-amber-700 mb-4">
      The issuing authority has issued modifications/date extensions for this tender.
    </p>

    <div class="space-y-3">
      <% @tender_data.corrigendums.each_with_index do |corr, idx| %>
        <div class="rounded-md border border-amber-200 bg-white p-3 shadow-xs">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div class="flex-1">
              <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
                #<%= idx + 1 %> <%= corr['type'] || 'Corrigendum' %>
              </span>
              <p class="mt-1 text-sm font-medium text-gray-900"><%= corr['title'] || corr['description'] || 'Amendment Notice' %></p>
            </div>
            <% if corr['new_closing_date'].present? %>
              <div class="text-right">
                <span class="text-xs text-gray-500 block">Extended End Date:</span>
                <span class="text-xs font-bold text-amber-900 bg-amber-100 px-2 py-1 rounded">
                  <%= (Time.parse(corr['new_closing_date']) rescue nil)&.strftime("%d/%m/%Y %I:%M %p") || corr['new_closing_date'] %>
                </span>
              </div>
            <% end %>
          </div>
          <% if corr['document_link'].present? %>
            <div class="mt-2 text-right">
              <a href="<%= corr['document_link'] %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-semibold text-orange-600 hover:text-orange-700 underline">
                <span>View Official Corrigendum Notice</span>
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
