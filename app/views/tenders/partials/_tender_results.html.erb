<div class="mt-8">
  <div class="rounded-lg border border-emerald-200 bg-emerald-50/40 p-6 shadow-xs">
    <div class="flex items-center gap-2 mb-4">
      <span class="inline-flex rounded-full bg-emerald-100 p-1 text-emerald-700">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </span>
      <h3 class="text-xl font-bold text-emerald-900">
        Award of Contract & Bid Results
      </h3>
    </div>

    <% 
      @bid_result ||= @tender_data&.parsed_bid_result || {}
      raw_winner = @bid_result['winner_name'] || @bid_result['awarded_to'] || @bid_result.dig('winner', 'name')
      if raw_winner.blank? && @bid_result.dig('contractFullData', 'sellerOrgName').present?
        raw_seller = @bid_result.dig('contractFullData', 'sellerOrgName').to_s.strip
        raw_winner = raw_seller if raw_seller.length < 80
      end

      # Reject status keywords that are not actual vendor/contractor names
      status_keywords = ['awarded', 'completed', 'closed', 'cancelled', 'under evaluation', 'retender', 'n/a', 'na', '-']
      winner = status_keywords.include?(raw_winner.to_s.strip.downcase) ? nil : raw_winner

      amount = @bid_result['contract_amount'] || @bid_result['award_value'] || @bid_result.dig('contractFullData', 'contractAmount') || @bid_result.dig('winner', 'awarded_value')
      status = @bid_result['status'] || @bid_result.dig('bid_data', 'BidStatus') || @bid_result.dig('contractFullData', 'contractStatus')&.lines&.first&.strip || (@bid_result['winner_name'] if status_keywords.include?(@bid_result['winner_name'].to_s.strip.downcase))
    %>

    <% if winner.present? || amount.present? %>
      <div class="mb-6 rounded-md bg-white p-4 border border-emerald-200 shadow-xs flex flex-wrap items-center justify-between gap-4">
        <% if winner.present? %>
          <div>
            <span class="text-xs font-semibold uppercase text-emerald-800 tracking-wider block">Awarded Contractor / Winner</span>
            <p class="text-lg font-bold text-gray-900 mt-1"><%= winner %></p>
          </div>
        <% end %>
        <% if amount.present? %>
          <div class="text-right">
            <span class="text-xs font-semibold uppercase text-gray-500 tracking-wider block">Contract Value</span>
            <p class="text-lg font-bold text-emerald-700 mt-1"><%= amount %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if status.present? || @bid_result['organisation'].present? || @bid_result['bid_data'].present? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm bg-white p-4 rounded-md border border-gray-200 mb-6">
        <% if status.present? %>
          <div>
            <span class="font-medium text-gray-500">Tender Status: </span>
            <span class="font-semibold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-sm text-xs capitalize"><%= status %></span>
          </div>
        <% end %>
        <% if @bid_result['organisation'].present? %>
          <div>
            <span class="font-medium text-gray-500">Authority / Source: </span>
            <span class="text-gray-900"><%= @bid_result['organisation'] %></span>
          </div>
        <% end %>
        <% if @bid_result.dig('bid_data', 'BidAdditionalReq').present? %>
          <div>
            <span class="font-medium text-gray-500">Additional Information: </span>
            <span class="text-gray-900"><%= @bid_result['bid_data']['BidAdditionalReq'] %></span>
          </div>
        <% end %>
        <% if @bid_result.dig('bid_data', 'Name').present? && !@bid_result['bid_data']['Name'].include?('***') %>
          <div>
            <span class="font-medium text-gray-500">Buyer Name: </span>
            <span class="text-gray-900"><%= @bid_result['bid_data']['Name'] %></span>
          </div>
        <% end %>
        <% if @bid_result.dig('bid_data', 'Ministry').present? %>
          <div>
            <span class="font-medium text-gray-500">Ministry: </span>
            <span class="text-gray-900"><%= @bid_result['bid_data']['Ministry'] %></span>
          </div>
        <% end %>
        <% if @bid_result.dig('bid_data', 'Department').present? %>
          <div>
            <span class="font-medium text-gray-500">Department: </span>
            <span class="text-gray-900"><%= @bid_result['bid_data']['Department'] %></span>
          </div>
        <% end %>
        <% if @bid_result.dig('bid_data', 'Organisation').present? %>
          <div>
            <span class="font-medium text-gray-500">Organisation: </span>
            <span class="text-gray-900"><%= @bid_result['bid_data']['Organisation'] %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @bid_result['tech_eval'].present? && @bid_result['tech_eval'].is_a?(Array) && @bid_result['tech_eval'].any? %>
      <div class="mb-6">
        <h4 class="text-base font-bold text-gray-900 mb-3">Technical Evaluation Results</h4>
        <div class="relative overflow-x-auto shadow-xs rounded-lg border border-gray-200 bg-white">
          <table class="w-full text-sm text-left text-gray-600">
            <% @bid_result['tech_eval'].each_with_index do |row, idx| %>
              <% if idx == 0 %>
                <thead class="text-xs uppercase bg-gray-100 text-gray-700">
                  <tr>
                    <% row.each do |td| %>
                      <th scope="col" class="px-4 py-3"><%= td %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
              <% else %>
                <tr class="hover:bg-gray-50">
                  <% row.each do |td| %>
                    <td class="px-4 py-3"><%= td %></td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if @bid_result['fin_eval'].present? && @bid_result['fin_eval'].is_a?(Array) && @bid_result['fin_eval'].any? %>
      <div class="mb-6">
        <h4 class="text-base font-bold text-gray-900 mb-3">Financial Evaluation Results</h4>
        <div class="relative overflow-x-auto shadow-xs rounded-lg border border-gray-200 bg-white">
          <table class="w-full text-sm text-left text-gray-600">
            <% @bid_result['fin_eval'].each_with_index do |row, idx| %>
              <% if idx == 0 %>
                <thead class="text-xs uppercase bg-gray-100 text-gray-700">
                  <tr>
                    <% row.each do |td| %>
                      <th scope="col" class="px-4 py-3"><%= td %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
              <% else %>
                <tr class="hover:bg-gray-50">
                  <% row.each do |td| %>
                    <td class="px-4 py-3"><%= td %></td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% 
      raw_table = @bid_result.dig('contract_details', 'contractTable') || @bid_result.dig('contractFullData', 'contractTable')
    %>
    <% if raw_table.present? && raw_table.is_a?(Array) %>
      <% 
        header_row = raw_table.first
        data_rows = raw_table.drop(1).reject { |r| r == header_row || r.all?(&:blank?) }
      %>
      <% if data_rows.any? %>
        <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-xs mb-4">
          <h4 class="text-base font-bold text-gray-900 mb-3">Ordered Items & Contract Pricing</h4>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-600">
              <thead class="text-xs uppercase bg-gray-100 text-gray-700">
                <tr>
                  <% (header_row || []).each do |th| %>
                    <th scope="col" class="px-4 py-3"><%= th %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% data_rows.each do |row| %>
                  <tr class="hover:bg-gray-50">
                    <% row.each_with_index do |cell, c_idx| %>
                      <td class="px-4 py-3 <%= c_idx == row.length - 1 ? 'font-semibold text-emerald-800' : '' %>">
                        <%= cell %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @bid_result['aoc_link'].present? %>
      <div class="mt-4 text-right">
        <a href="<%= @bid_result['aoc_link'] %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-md bg-emerald-600 px-3 py-2 text-xs font-semibold text-white shadow-xs hover:bg-emerald-700">
          <span>View Official Award Notice (AOC)</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    <% end %>

  </div>
</div>
