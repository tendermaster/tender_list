<%# Under the header of a closed tender (where most search visitors land):
    what to do next. locals: tender, open_similar (count of open similar
    tenders), result (:winner when the bid result names one, :details for
    other result data, else nil) %>
<div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 dark:border-amber-800 dark:bg-amber-950">
  <p class="text-sm font-semibold text-amber-900 dark:text-amber-100">
    This tender closed on <%= tender.submission_close_date.strftime('%d %b %Y') %>.
    <% if open_similar.positive? %>
      <%= pluralize(open_similar, 'tender') %> like it <%= open_similar == 1 ? 'is' : 'are' %> open now.
    <% end %>
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <a href="#relevant_tenders_form" class="rounded-md bg-orange-600 px-3 py-2 text-sm font-semibold text-white hover:bg-orange-700">Get new ones on WhatsApp</a>
    <% if result %>
      <a href="#bid-results" class="rounded-md border border-emerald-300 bg-white px-3 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-50 dark:bg-transparent dark:text-emerald-300"><%= result == :winner ? 'See who won' : 'See the bid result' %></a>
    <% end %>
  </div>
</div>
