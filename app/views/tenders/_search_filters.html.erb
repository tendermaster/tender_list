<%# Search filters: open only, state, order. Keeps the search (q) and drops the page. %>
<% select_class = 'rounded-lg border border-gray-300 bg-white py-1.5 pl-3 pr-8 text-sm text-gray-800 focus:border-orange-500 focus:ring-orange-500 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200' %>
<%= form_with url: request.path, method: :get, local: true,
              class: 'mb-6 flex flex-wrap items-center gap-x-4 gap-y-2',
              data: { controller: 'auto-submit', turbo: false } do %>
  <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
  <p class="mr-auto text-sm text-gray-600 dark:text-gray-400">
    <%= total.to_i >= 10_000 ? '10,000+' : number_with_delimiter(total.to_i) %> <%= 'tender'.pluralize(total.to_i) %>
  </p>

  <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
    <%= check_box_tag :status, 'open', filters[:open], id: 'filter-open', data: { action: 'auto-submit#submit' },
                      class: 'rounded-sm border-gray-300 text-orange-600 focus:ring-orange-500' %>
    Open only
  </label>

  <%= select_tag :state, options_for_select(Query::STATES.excluding('All India'), filters[:state]),
                 include_blank: 'All states', 'aria-label': 'State', class: select_class,
                 data: { action: 'auto-submit#submit' } %>

  <%= select_tag :sort, options_for_select([['Most relevant', 'relevance'], ['Closing soonest', 'closing'], ['Newest', 'newest']], filters[:sort]),
                 'aria-label': 'Sort by', class: select_class, data: { action: 'auto-submit#submit' } %>

  <noscript><%= submit_tag 'Apply', name: nil, class: 'btn-sm' %></noscript>
<% end %>
