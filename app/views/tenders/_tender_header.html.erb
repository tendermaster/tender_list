<%# Top of the tender page: what it is, who's buying, where, when it closes
    and the money involved. locals: tender, days_left, unlocked %>
<%
  days = ist_days_until(tender.submission_close_date)
  status =
    if days_left.nil?
      ['Closing date not given', 'bg-gray-100 text-gray-700 ring-gray-200']
    elsif days_left.negative?
      ["Closed #{tender.submission_close_date.strftime('%-d %b %Y')}", 'bg-red-50 text-red-700 ring-red-200']
    elsif days <= 0
      ['Closes today', 'bg-orange-100 text-orange-800 ring-orange-300']
    elsif days == 1
      ['Closes tomorrow', 'bg-orange-100 text-orange-800 ring-orange-300']
    elsif days <= 3
      ["Closes in #{days} days", 'bg-orange-100 text-orange-800 ring-orange-300']
    else
      ["Open · #{days} days left", 'bg-green-50 text-green-700 ring-green-200']
    end
  hidden_title = !unlocked && is_tender_id?(tender.title)
%>
<header class="rounded-xl border border-gray-200 bg-white p-5 shadow-xs sm:p-6 dark:border-gray-700 dark:bg-gray-800">
  <div class="flex flex-wrap items-center gap-2 text-sm">
    <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= status[1] %>"><%= status[0] %></span>
    <% if tender.has_corrigendum? %>
      <a href="#corrigenda" class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800 ring-1 ring-inset ring-amber-200 hover:bg-amber-100">Amended</a>
    <% end %>
    <% if tender.submission_close_date && !days_left&.negative? %>
      <span class="text-gray-600 dark:text-gray-300">Bids due <%= tender.submission_close_date.strftime('%-d %b %Y, %-I:%M %p') %></span>
    <% end %>
  </div>

  <h1 class="mt-3 text-xl font-bold leading-snug text-gray-900 sm:text-2xl dark:text-white">
    <% if hidden_title %>
      Tender from <%= tender.organisation.presence || 'a government department' %>
    <% else %>
      <%= tender_text(tender.title) %>
    <% end %>
  </h1>

  <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
    <%= [tender.organisation.presence, tender.state.presence].compact.join(' · ') %>
  </p>

  <% tiles = tender_fee_tiles(tender) %>
  <% if tiles.any? %>
  <dl class="mt-5 grid <%= %w[grid-cols-1 grid-cols-2 grid-cols-3][tiles.size - 1] %> gap-2 sm:max-w-2xl sm:gap-3">
    <% tiles.each do |label, amount| %>
      <div class="rounded-lg bg-gray-50 px-3 py-2.5 dark:bg-gray-700/50">
        <dt class="text-xs text-gray-500 dark:text-gray-400"><%= label %></dt>
        <dd class="mt-0.5 font-semibold text-gray-900 sm:text-lg dark:text-white"><%= amount %></dd>
      </div>
    <% end %>
  </dl>
  <% end %>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <% if unlocked && tender.page_link.present? %>
      <a class="inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-3 py-2 text-sm font-semibold text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900"
         target="_blank" rel="nofollow noopener noreferrer" href="<%= tender.page_link %>">
        Original notice
        <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M6 18h10.5A1.5 1.5 0 0 0 18 16.5v-3M6 18A1.5 1.5 0 0 1 4.5 16.5v-9A1.5 1.5 0 0 1 6 6h3" />
        </svg>
      </a>
    <% elsif !unlocked %>
      <%= render 'tenders/plan_to_view_tender', label: 'Sign in free for the tender ID and link' %>
    <% end %>
    <%= render 'tenders/bookmark_button', tender: tender, saved: tender_bookmarked?(current_user&.id, tender.id) %>
  </div>
</header>
