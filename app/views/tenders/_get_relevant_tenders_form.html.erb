<%# Tender alerts, in the tender and search page sidebars, on the home page
    and on searches with no results. Signed-out visitors leave their details
    (a tender_alerts Lead, TenderAlertRequestsController); signed-in users
    too, since saved-search alerts are emails and email is off. locals (all optional): keywords (prefilled),
    heading, intro, tender (the tender page it's on, saved with the lead) %>
<% keywords = local_assigns[:keywords].to_s.squish.truncate(120, omission: '') %>
<% heading = local_assigns[:heading] || (keywords.present? ? "Get new #{keywords} tenders" : 'Get tenders for your business') %>
<% input = 'mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-orange-500 focus:ring-orange-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white' %>
<% label = 'block text-sm font-medium text-gray-900 dark:text-white' %>
<div id="relevant_tenders_form" class="mb-6 rounded-lg border border-orange-200 bg-white p-5 shadow-xs dark:border-gray-700 dark:bg-gray-800">
  <h3 class="text-base font-semibold text-gray-900 dark:text-white"><%= heading %></h3>

  <%# Saved-search alerts go by email, which is off (docs/email.md): signed-in
      users send this too, with their account's name and number %>
  <p class="mt-1 text-sm text-gray-600 dark:text-gray-300"><%= local_assigns[:intro] || "Tell us what you supply or do. We'll send you matching tenders on WhatsApp and call you about them." %></p>
  <%= form_with url: get_relevant_tenders_post_path, id: 'relevant-tenders-form', authenticity_token: false,
                class: 'mt-4 space-y-3', data: { turbo: false } do |form| %>
    <div>
      <%= form.label :sectors, 'What do you supply or do?', class: label %>
      <%= form.text_area :sectors, value: keywords.presence, rows: 2, required: true, maxlength: 2000, class: input,
                         placeholder: 'e.g. CCTV, road construction, manpower supply' %>
    </div>
    <fieldset>
      <legend class="<%= label %>">Want us to file bids for you?</legend>
      <div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-700 dark:text-gray-300">
        <% ['Yes, help me bid', 'Just send tenders'].each_with_index do |option, index| %>
          <label class="inline-flex items-center gap-1.5">
            <%= radio_button_tag :bid_help, option, false, id: "bid_help_#{index}", class: 'border-gray-300 text-orange-600 focus:ring-orange-500' %>
            <%= option %>
          </label>
        <% end %>
      </div>
    </fieldset>
    <% if user_signed_in? %>
      <% if current_user.phone.blank? %>
        <div>
          <%= form.label :mobile, 'Mobile number', class: label %>
          <%= form.telephone_field :mobile, required: true, inputmode: 'tel', autocomplete: 'tel', placeholder: '98765 43210', class: input %>
        </div>
      <% end %>
      <p class="text-xs text-gray-500">We'll contact you at <span data-ph-mask><%= current_user.phone.presence || 'this number' %></span>.</p>
    <% else %>
      <div>
        <%= form.label :name, 'Your name', class: label %>
        <%= form.text_field :name, required: true, maxlength: 120, autocomplete: 'name', class: input %>
      </div>
      <div>
        <%= form.label :mobile, 'Mobile number', class: label %>
        <%= form.telephone_field :mobile, required: true, inputmode: 'tel', autocomplete: 'tel', placeholder: '98765 43210', class: input %>
      </div>
      <div>
        <%= form.label :email, 'Email (optional)', class: label %>
        <%= form.email_field :email, maxlength: 120, autocomplete: 'email', class: input %>
      </div>
    <% end %>
    <% if local_assigns[:tender] %>
      <%= hidden_field_tag :tender, local_assigns[:tender].slug_uuid %>
    <% end %>
    <%= render 'leads/bot_checks', captcha: !user_signed_in? %>
    <%= form.submit 'Get tenders on WhatsApp', class: 'btn-primary w-full text-sm' %>
  <% end %>

  <a href="/#download-checklist" class="mt-4 block text-sm text-gray-600 hover:text-orange-700 hover:underline dark:text-gray-300">Free tender checklists for your industry →</a>
</div>
