<%# Tender page sidebar: makers and prices of the products the tender is
    for, on products.sigmatenders.com. locals: tender %>
<% products = tender_products(tender) %>
<% if products.any? %>
  <div class="mb-6 rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800">
    <h2 class="font-semibold text-gray-900 dark:text-white">Buying for this tender?</h2>
    <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">Compare BIS-licensed makers, prices and sizes, and get quotes.</p>
    <ul class="mt-3 space-y-1 text-sm">
      <% products.each do |slug, name| %>
        <li><a href="https://products.sigmatenders.com/<%= slug %>" class="font-medium text-orange-700 hover:underline dark:text-orange-400"><%= name %>: makers and prices</a></li>
      <% end %>
    </ul>
  </div>
<% end %>
