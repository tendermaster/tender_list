<%# The tender's particulars. locals: tender, unlocked %>
<%
  # Portal dates are IST wall-clock times stored as UTC: shown as stored
  ist = ->(time) { time&.strftime('%-d %b %Y, %-I:%M %p') || '–' }
  locked = ->(label) { render('tenders/plan_to_view_tender', label: label) }
  rows = [
    ['Tender ID', unlocked ? tender.tender_id.presence : locked.call('Sign in to view')],
    ['Reference number', unlocked ? (@tender_json&.dig('TenderReferenceNumber').presence || tender.tender_reference_number.presence) : locked.call('Sign in to view')],
    ['Organisation', tender.organisation.presence],
    ['Location', tender.state.presence],
    ['Bids open', ist.call(tender.submission_open_date)],
    ['Bids close', ist.call(tender.submission_close_date)],
    ['Tender value', rupees(tender.tender_value)],
    ['EMD', rupees(tender.emd)],
    ['Tender fee', rupees(tender.tender_fee)]
  ]
  description = tender_text(tender.description)
  description = nil if description.blank? || description.casecmp?(tender_text(tender.title))
%>
<section id="details" class="mt-8 scroll-mt-6">
  <h2 class="text-lg font-bold text-gray-900 dark:text-white">Tender details</h2>

  <% if description || tender.short_blog.present? %>
    <div class="mt-3 space-y-3 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
      <% if description %><p><%= description %></p><% end %>
      <% if tender.short_blog.present? %><p class="whitespace-pre-line"><%= tender_text(tender.short_blog) %></p><% end %>
    </div>
  <% end %>

  <dl class="mt-4 grid grid-cols-1 overflow-hidden rounded-lg border border-gray-200 bg-white sm:grid-cols-2 dark:border-gray-700 dark:bg-gray-800">
    <% rows.each do |label, value| %>
      <div class="border-b border-gray-100 px-4 py-3 sm:odd:border-r dark:border-gray-700">
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400"><%= label %></dt>
        <dd class="mt-1 break-words text-sm text-gray-900 dark:text-white"><%= value.presence || '–' %></dd>
      </div>
    <% end %>
  </dl>

  <% if unlocked && tender.page_link.present? %>
    <p class="mt-3 text-xs text-gray-500">
      Source: <a class="force-word-break underline hover:text-orange-700" href="<%= tender.page_link %>" target="_blank" rel="nofollow noopener noreferrer"><%= tender.page_link.truncate(90) %></a>
    </p>
  <% end %>
</section>
