<% set_meta_tags title: 'Welcome', robots: 'noindex, nofollow' %>
<%= render 'layouts/navbar' %>

<div class="mx-auto w-full max-w-2xl px-4 py-10" data-controller="onboarding">
  <h1 class="text-2xl font-bold text-gray-900 md:text-3xl">
    Welcome<%= ", #{current_user.name.split.first}" if current_user.name.present? %> 👋
  </h1>
  <p class="mt-2 text-gray-600">Tell us what you bid on. We'll show matching open tenders now, and our team will call you to help you find and win more.</p>

  <% if @errors.present? %>
    <ul class="mt-6 list-inside list-disc rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-600" id="alert">
      <% @errors.each do |error| %><li><%= error %></li><% end %>
    </ul>
  <% end %>

  <%= form_with scope: :onboarding, url: welcome_path, method: :patch, class: 'mt-8 space-y-8',
                data: { action: 'submit->onboarding#submit' } do |f| %>
    <%= hidden_field_tag :return_to, return_to if return_to %>
    <div>
      <%= f.label :keywords, 'What do you bid on?', class: 'block font-semibold text-gray-900' %>
      <p class="text-sm text-gray-500">Products or types of work, separated by commas</p>
      <%= f.text_field :keywords, value: @form[:keywords], required: true, autofocus: @form[:keywords].blank?,
                       placeholder: 'e.g. solar street lights, road repair',
                       data: { onboarding_target: 'keywords' },
                       class: 'mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2.5 placeholder:text-gray-400 focus:border-orange-500 focus:ring-orange-500' %>
      <div class="mt-3 flex flex-wrap gap-2">
        <% OnboardingsController::KEYWORD_SUGGESTIONS.each do |keyword| %>
          <button type="button" data-keyword="<%= keyword %>" data-action="onboarding#addKeyword"
                  class="rounded-full border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:border-orange-500 hover:text-orange-700">
            + <%= keyword %>
          </button>
        <% end %>
      </div>
    </div>

    <fieldset>
      <legend class="font-semibold text-gray-900">States you work in</legend>
      <div class="mt-2 grid max-h-56 grid-cols-1 gap-x-4 gap-y-1 overflow-y-auto rounded-lg border border-gray-200 p-3 sm:grid-cols-2">
        <% Query::STATES.each do |state| %>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= check_box_tag 'onboarding[states][]', state, @form[:states].include?(state), id: nil,
                              class: 'rounded-sm border-gray-300 text-orange-600 focus:ring-orange-500' %>
            <%= state %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset>
      <legend class="font-semibold text-gray-900">Your business <span class="font-normal text-gray-500">(optional)</span></legend>
      <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
        <% User::BUSINESS_TYPES.each do |type| %>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= f.radio_button :business_type, type, checked: @form[:business_type] == type,
                               class: 'border-gray-300 text-orange-600 focus:ring-orange-500' %>
            <%= type %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= f.label :phone, 'Mobile number', class: 'block font-semibold text-gray-900' %>
      <div class="mt-2 flex max-w-xs rounded-lg border border-gray-300 focus-within:border-orange-500">
        <span class="flex items-center border-r border-gray-300 bg-gray-50 px-3 text-gray-600 rounded-l-lg">+91</span>
        <%= f.telephone_field :phone, value: @form[:phone].delete_prefix('+91'), required: true,
                              inputmode: 'numeric', autocomplete: 'tel-national', placeholder: '98765 43210',
                              class: 'block w-full rounded-r-lg border-0 px-3 py-2.5 placeholder:text-gray-400 focus:ring-0' %>
      </div>
      <label class="mt-3 flex items-start gap-2 text-sm text-gray-600">
        <%= f.check_box :consent, { checked: @form[:consent] == '1', class: 'mt-0.5 rounded-sm border-gray-300 text-orange-600 focus:ring-orange-500' }, '1', '0' %>
        SigmaTenders may call or WhatsApp me about tenders that match my business.
      </label>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= f.submit 'Show my tenders →', class: 'btn-primary' %>
      <%= link_to 'Skip for now', return_to || queries_path, class: 'text-sm text-gray-500 hover:underline',
                  data: { action: 'onboarding#skip' } %>
    </div>
  <% end %>
</div>

<%= render 'layouts/footer' %>
