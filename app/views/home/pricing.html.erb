<%# /pricing: finding tenders is free; the team's work is what's paid for
    (docs/pivot.md in the infra repo). Prices are quoted after a call until
    the first sales show what to fix them at. The subscription plans were
    taken off on 2026-11-10: what they sold is free after signing in, and
    their email alerts can't be sent. %>
<% set_meta_tags title: 'Pricing & Services',
                 description: 'Search tenders free. Pay only when you want our team to prepare and file your bid, register you on GeM or run your tendering.' %>
<%= render 'layouts/navbar' %>

<%
  services = [
    { title: 'Bid filing', badge: 'Most asked for',
      text: 'Send us the tender you want. We read the documents, check your eligibility, prepare the bid and file it on the portal before the deadline. You approve everything before it goes in.',
      points: ['Eligibility and document check', 'Technical and financial bid prepared', 'EMD and fee guidance', 'Online submission on the portal'],
      cta: 'Get a quote', path: enquiry_path('bid_support') },
    { title: 'GeM registration',
      text: 'Get your business on the Government e-Marketplace, with your products or services listed so government buyers can find and order from you.',
      points: ['Seller registration and vendor assessment', 'Product or service catalogue', 'Help with your first GeM bids'],
      cta: 'Get a quote', path: enquiry_path('gem_registration') },
    { title: 'Get bid-ready',
      text: 'Most bids fail on paperwork. We get you ready before the next tender opens, so you aren\'t racing a deadline.',
      points: ['Digital signature certificate (DSC)', 'MSME (Udyam) registration, which can waive the EMD', 'Portal vendor registration', 'Document and compliance review'],
      cta: 'Get a quote', path: enquiry_path('bid_ready') },
    { title: 'Tender desk', badge: 'Yearly',
      text: 'Your own tendering team. We screen new tenders for you every day, send you the ones worth bidding on, and handle the bids you choose.',
      points: ['Tenders screened for your business daily', 'Shortlist on WhatsApp', 'Bids prepared and filed', 'One person who knows your business'],
      cta: 'Talk to us', path: enquiry_path('tender_desk') }
  ]
  free = [
    ['Search every tender', 'Central, state, PSU and GeM tenders from across India.'],
    ['Tender IDs and original links', 'Free once you sign in with Google.'],
    ['Tenders on WhatsApp', "Tell us what you supply and we'll send you matching tenders."],
    ['Saved tenders and searches', 'Keep a list of the tenders you are looking at.']
  ]
  check = '<svg class="mt-0.5 h-4 w-4 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>'.html_safe
%>

<div class="bg-gray-50">
  <section class="bg-gradient-to-r from-orange-500 to-orange-600 text-white">
    <div class="mx-auto max-w-5xl px-4 py-14 text-center sm:px-6">
      <h1 class="text-3xl font-bold sm:text-5xl">Pricing &amp; Services</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-orange-50 sm:text-xl">
        Finding tenders is free. Pay only when you want our team to do the work: preparing and filing bids, GeM registration and running your tendering.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="#services" class="rounded-lg bg-white px-6 py-3 font-semibold text-orange-700 hover:bg-orange-50">See our services</a>
        <a href="https://wa.me/918882301033?text=<%= ERB::Util.url_encode('Hi, I want help with government tenders') %>" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center justify-center gap-2 rounded-lg border border-white px-6 py-3 font-semibold text-white hover:bg-white/10">
          <%= render 'tenders/whatsapp_icon' %> Ask on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-bold text-gray-900">Free for everyone</h2>
        <span class="text-2xl font-bold text-green-700">₹0</span>
      </div>
      <dl class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <% free.each do |title, text| %>
          <div class="flex gap-2">
            <%= check %>
            <div>
              <dt class="font-semibold text-gray-900"><%= title %></dt>
              <dd class="mt-1 text-sm text-gray-600"><%= text %></dd>
            </div>
          </div>
        <% end %>
      </dl>
      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to 'Search tenders', root_path, class: 'rounded-lg bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-orange-700' %>
        <%= link_to 'Get tenders on WhatsApp', get_relevant_tenders_path, rel: 'nofollow', class: 'rounded-lg border border-orange-600 px-5 py-2.5 text-sm font-semibold text-orange-700 hover:bg-orange-50' %>
      </div>
    </div>
  </section>

  <section id="services" class="mx-auto max-w-6xl scroll-mt-6 px-4 pb-14 sm:px-6">
    <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">When you want us to do the work</h2>
    <p class="mt-2 max-w-3xl text-gray-600">Every job starts with a free call. We tell you what it needs and quote a fixed price before you pay anything.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <% services.each do |service| %>
        <div class="flex flex-col rounded-2xl border <%= service[:badge] == 'Most asked for' ? 'border-2 border-orange-500' : 'border-gray-200' %> bg-white p-6 shadow-xs">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-xl font-bold text-gray-900"><%= service[:title] %></h3>
            <% if service[:badge] %>
              <span class="rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-800"><%= service[:badge] %></span>
            <% end %>
          </div>
          <p class="mt-2 text-sm text-gray-700"><%= service[:text] %></p>
          <ul class="mt-4 space-y-2 text-sm text-gray-700">
            <% service[:points].each do |point| %>
              <li class="flex gap-2"><%= check %><span><%= point %></span></li>
            <% end %>
          </ul>
          <p class="mt-5 text-sm font-semibold text-gray-900">Fixed price, quoted after a free call</p>
          <%= link_to service[:cta], service[:path], rel: 'nofollow',
                      class: 'mt-3 rounded-lg bg-orange-600 px-5 py-2.5 text-center text-sm font-semibold text-white hover:bg-orange-700 sm:self-start' %>
        </div>
      <% end %>
    </div>

    <p class="mt-6 text-sm text-gray-600">
      Also: <%= link_to 'find a JV, consortium or local partner', find_partner_path, rel: 'nofollow', class: 'font-semibold text-orange-700 hover:underline' %>
      for a tender you can't bid on alone, or <%= link_to 'get quotes from suppliers', enquiry_path('rfq'), rel: 'nofollow', class: 'font-semibold text-orange-700 hover:underline' %>
      for what a tender asks you to supply.
    </p>
  </section>

  <section class="border-t border-gray-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2 class="text-2xl font-bold text-gray-900">How it works</h2>
      <ol class="mt-6 grid gap-6 md:grid-cols-3">
        <% [['Tell us what you need', 'Send the tender, or tell us what you supply. On the form, on WhatsApp or by phone.'],
            ['Free call and a fixed quote', 'We go through the tender and your documents and tell you the price before you pay.'],
            ['We do the work', 'You approve the bid before we file it, and we keep you posted until the result.']].each_with_index do |(title, text), index| %>
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-600 font-bold text-white"><%= index + 1 %></span>
            <div>
              <h3 class="font-semibold text-gray-900"><%= title %></h3>
              <p class="mt-1 text-sm text-gray-600"><%= text %></p>
            </div>
          </li>
        <% end %>
      </ol>

      <div class="mt-12 flex flex-col gap-3 rounded-2xl bg-gray-50 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-semibold text-gray-900">Questions? Talk to us.</p>
          <p class="mt-1 text-sm text-gray-600">Already a subscriber? Your plan carries on as before; WhatsApp us for anything you need.</p>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
          <a href="https://wa.me/918882301033" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center justify-center gap-2 rounded-lg bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700">
            <%= render 'tenders/whatsapp_icon' %> WhatsApp
          </a>
          <%= link_to 'Request a call', enquiry_path('callback'), rel: 'nofollow',
                      class: 'rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-center text-sm font-semibold text-gray-700 hover:bg-gray-50' %>
        </div>
      </div>
    </div>
  </section>
</div>

<%= render 'layouts/footer' %>
