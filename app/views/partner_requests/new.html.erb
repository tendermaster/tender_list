<% sent = params[:sent].present? %>
<% set_meta_tags title: 'Find a Bidding Partner: JV, Consortium or Subcontractor',
                  description: "Can't meet a tender's eligibility alone, or need a team where the work is? Tell us and we'll find a JV, consortium or local partner.",
                  canonical: find_partner_url,
                  robots: (@tender || sent || @lead.errors.any? ? 'noindex, follow' : nil) %>
<%= render 'layouts/navbar' %>
<% input = 'mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-orange-500 focus:ring-orange-500' %>

<div class="mx-auto w-full max-w-5xl px-4 py-10">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <h1 class="text-3xl font-bold text-gray-900">Find a bidding partner</h1>
      <p class="mt-3 text-gray-600">Can't meet a tender's turnover, experience or certification rules alone? Need a team where the work is? Tell us what's missing and we'll find a partner for you.</p>

      <% if @tender %>
        <div class="mt-6 rounded-lg border border-gray-200 bg-gray-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">For this tender</p>
          <%= link_to @tender.title.to_s.squish.truncate(160), tender_show_path(slug_uuid: @tender.slug_uuid),
                      class: 'mt-1 block font-semibold text-gray-900 hover:underline' %>
          <p class="mt-1 text-sm text-gray-600"><%= [@tender.organisation.to_s.squish.truncate(80), @tender.state].compact_blank.join(' · ') %></p>
          <% if @tender.submission_close_date %>
            <p class="mt-1 text-sm text-gray-600">Closes <%= @tender.submission_close_date.utc.strftime('%-d %b %Y') %></p>
          <% end %>
        </div>
      <% end %>

      <h2 class="mt-8 font-semibold text-gray-900">How it works</h2>
      <ol class="mt-2 list-inside list-decimal space-y-1 text-sm text-gray-600">
        <li>Tell us what you need for the tender.</li>
        <li>We call you to understand the requirement.</li>
        <li>We introduce partners who fill the gap: turnover, experience, certification or a local team.</li>
      </ol>
    </div>

    <div class="lg:col-span-3">
      <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
        <% if sent %>
          <h2 class="text-lg font-semibold text-gray-900">Request received</h2>
          <p class="mt-2 text-sm text-gray-600">We'll call you to understand what you need, usually within one working day.</p>
          <%= link_to(@tender ? 'Back to the tender' : 'Find tenders', @tender ? tender_show_path(slug_uuid: @tender.slug_uuid) : root_path,
                      class: 'mt-4 inline-block text-sm font-semibold text-orange-700 hover:underline') %>
        <% else %>
          <% if @lead.errors.any? %>
            <ul class="mb-4 list-inside list-disc rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-600" id="alert">
              <% @lead.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
            </ul>
          <% end %>

          <%= form_with model: @lead, url: find_partner_path(tender: @tender&.slug_uuid), class: 'space-y-4',
                        data: { turbo: false } do |f| %>
            <fieldset>
              <legend class="text-sm font-medium text-gray-900">What do you need?</legend>
              <div class="mt-2 space-y-2">
                <% Lead::PARTNER_NEEDS.each do |need| %>
                  <label class="flex items-start gap-2 text-sm text-gray-700">
                    <%= f.radio_button :partner_need, need, required: true,
                                       class: 'mt-0.5 border-gray-300 text-orange-600 focus:ring-orange-500' %>
                    <%= need %>
                  </label>
                <% end %>
              </div>
            </fieldset>
            <div>
              <%= f.label :details, "What's missing?", class: 'block text-sm font-medium text-gray-900' %>
              <%= f.text_area :details, rows: 3, maxlength: 2000, class: input,
                              placeholder: 'e.g. turnover of ₹5 Cr, similar work experience, ISO 9001, a team in Assam' %>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <%= f.label :company, 'Company name', class: 'block text-sm font-medium text-gray-900' %>
                <%= f.text_field :company, maxlength: 120, autocomplete: 'organization', class: input %>
              </div>
              <div>
                <%= f.label :annual_turnover, 'Your annual turnover', class: 'block text-sm font-medium text-gray-900' %>
                <%= f.select :annual_turnover, User::TURNOVER_BANDS, { include_blank: 'Choose…' }, class: input %>
              </div>
            </div>
            <div>
              <%= f.label :location, 'Your city and state', class: 'block text-sm font-medium text-gray-900' %>
              <%= f.text_field :location, required: true, maxlength: 120, placeholder: 'e.g. Guwahati, Assam', class: input %>
            </div>

            <%= render 'leads/contact_fields', f:, lead: @lead, input: %>

            <%= f.submit 'Find a partner', class: 'btn-primary w-full' %>
            <p class="text-xs text-gray-500">By sending this you agree that SigmaTenders may call, WhatsApp or email you about this request.</p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render 'layouts/footer' %>
