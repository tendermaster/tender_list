<%= render 'layouts/navbar' %>
<div class="flex justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <h1 class="text-center text-2xl font-bold text-gray-900 dark:text-white">Sign in to Sigma Tenders</h1>
    <p class="mt-2 text-center text-sm text-gray-500 dark:text-gray-400">New or returning, one click with your Google account.</p>
    <div class="text-center"><%= render 'layouts/flash' %></div>

    <div class="mt-8"><%= render 'devise/shared/google_button' %></div>

    <%= render 'devise/shared/email_divider', label: 'or use email' %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'new_user px-0 pt-0 sm:max-w-none' }) do |f| %>
      <div>
        <%= f.label :email, class: 'mb-2 block text-sm font-medium text-gray-900 dark:text-white' %>
        <%= f.email_field :email, autocomplete: "email" %>
      </div>

      <div>
        <%= f.label :password, class: 'mb-2 block text-sm font-medium text-gray-900 dark:text-white' %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-3">
          <%= f.check_box :remember_me, { checked: true, class: 'h-4 w-4 rounded-sm border-gray-300 bg-gray-100 text-orange-600 focus:ring-2 focus:ring-orange-500' } %>
          <%= f.label :remember_me, class: 'text-sm text-gray-700 dark:text-gray-300' %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Log in", class: 'w-full' %>
      </div>
    <% end %>

    <div class="mt-6 space-y-2 text-center text-sm text-gray-600 dark:text-gray-400">
      <p>New here? <%= link_to 'Create an account', new_registration_path(resource_name), class: 'font-semibold text-orange-600 hover:underline' %></p>
      <% if ActionMailer::Base.perform_deliveries %>
        <p><%= link_to 'Forgot your password?', new_password_path(resource_name), class: 'hover:underline' %></p>
      <% else %>
        <p>Forgot your password? Use <span class="font-medium">Continue with Google</span> with the same email.</p>
      <% end %>
    </div>
  </div>
</div>
<%= render 'layouts/footer' %>
