<% quoted = params[:quoted].present? %>
<% set_meta_tags title: @product.seo_title,
                  description: @product.summary,
                  canonical: product_url(@product),
                  robots: (quoted || @lead.errors.any? ? 'noindex, follow' : nil),
                  **social_meta(title: "#{@product.name}: Buying Guide & Quotes", description: @product.summary,
                                url: product_url(@product)) %>
<%= product_page_schema(@product) %>
<%= render 'layouts/navbar' %>

<div class="mx-auto w-full max-w-6xl px-4 py-8">
  <nav class="text-sm text-gray-500" aria-label="Breadcrumb">
    <%= link_to 'Products', products_path, class: 'hover:underline' %> ›
    <span><%= @product.category %></span>
  </nav>

  <% configs = @product.configuration_list %>
  <% h2 = 'text-xl font-semibold text-gray-900' %>
  <div class="mt-4 grid grid-cols-1 gap-8 lg:grid-cols-3" data-controller="quote-prefill">
    <div class="lg:col-span-2">
      <header class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <% if @product.image_url.present? %>
          <%= image_tag @product.image_url, alt: @product.name, class: 'h-32 w-32 shrink-0 rounded-lg border border-gray-200 bg-white object-contain p-2' %>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900 md:text-4xl"><%= @product.name %></h1>
          <p class="mt-2 text-gray-600"><%= @product.summary %></p>
          <p class="mt-3 text-sm text-gray-700">Tell us what you need. Our team finds suppliers, checks availability and gets you quotes, usually within one working day.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="#quote" class="btn-primary text-sm">Request a quote</a>
            <% if configs.any? %>
              <a href="#choose" class="rounded-lg border border-orange-600 px-5 py-3 text-sm font-medium text-orange-700 hover:bg-orange-50">Compare options</a>
            <% end %>
          </div>
        </div>
      </header>

      <% if configs.any? %>
        <section id="choose" class="mt-10 scroll-mt-4">
          <h2 class="<%= h2 %>">Choose your requirement</h2>
          <p class="mt-1 text-sm text-gray-600">Typical configurations. Pick one to start your request; the exact make and specifications are confirmed with suppliers.</p>
          <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <% configs.each do |config| %>
              <li id="<%= config.key %>" class="flex flex-col rounded-lg border border-gray-200 bg-white p-5 scroll-mt-4"
                  data-quote-prefill-target="card">
                <h3 class="font-semibold text-gray-900"><%= config.name %></h3>
                <p class="mt-1 text-sm text-gray-600"><%= config.summary %></p>
                <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
                  <% config.attributes.each do |label, value| %>
                    <dt class="text-gray-500"><%= label %></dt>
                    <dd class="font-medium text-gray-900"><%= value %></dd>
                  <% end %>
                </dl>
                <button type="button" class="mt-4 rounded-lg border border-orange-600 px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50 aria-pressed:bg-orange-600 aria-pressed:text-white sm:mt-auto"
                        aria-pressed="false"
                        data-action="quote-prefill#choose"
                        data-quote-prefill-name-param="<%= config.name %>"
                        data-quote-prefill-text-param="<%= "#{config.name}: #{config.attributes.map { |k, v| "#{k} #{v}" }.join(', ')}. Equivalent models are acceptable." %>">
                  Request this configuration
                </button>
              </li>
            <% end %>
            <li class="flex flex-col justify-center rounded-lg border border-dashed border-gray-300 p-5" data-quote-prefill-target="card">
              <h3 class="font-semibold text-gray-900">Not sure which one?</h3>
              <p class="mt-1 text-sm text-gray-600">Tell us where and how it will be used, and we'll suggest the right option.</p>
              <button type="button" class="mt-4 rounded-lg border border-gray-400 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 aria-pressed:bg-gray-700 aria-pressed:text-white"
                      aria-pressed="false"
                      data-action="quote-prefill#choose"
                      data-quote-prefill-name-param=""
                      data-quote-prefill-text-param="Not sure which option suits us. Our use: ">
                Help me choose
              </button>
            </li>
          </ul>
        </section>

        <section class="mt-10">
          <h2 class="<%= h2 %>">Compare options</h2>
          <div class="mt-4 overflow-x-auto rounded-lg border border-gray-200 bg-white">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-4 py-3 font-semibold text-gray-700"></th>
                  <% configs.each do |config| %><th scope="col" class="px-4 py-3 font-semibold text-gray-900"><%= config.name %></th><% end %>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @product.configuration_labels.each do |label| %>
                  <tr>
                    <th scope="row" class="px-4 py-2 font-medium text-gray-500"><%= label %></th>
                    <% configs.each do |config| %><td class="px-4 py-2 text-gray-900"><%= config.attributes[label] || '—' %></td><% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-gray-500">Typical values; they vary by make and model.</p>
        </section>
      <% end %>

      <section class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">What your quote should include</h2>
          <ul class="mt-3 list-inside list-disc space-y-1 text-sm text-gray-700">
            <% Product::QUOTE_INCLUDES.each do |item| %><li><%= item %></li><% end %>
          </ul>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">How it works</h2>
          <ol class="mt-3 list-inside list-decimal space-y-1 text-sm text-gray-700">
            <li>Share your requirement: quantity, specifications and delivery location.</li>
            <li>Our team finds suppliers and checks availability.</li>
            <li>You receive quotes and decide. There's no obligation to buy.</li>
          </ol>
        </div>
      </section>

      <section class="mt-10">
        <h2 class="<%= h2 %>">Buying guide</h2>
        <div class="prose mt-4 max-w-none rounded-lg border border-gray-200 bg-white p-6 sm:p-8 prose-a:text-orange-700">
          <%= @product.body_html.html_safe %>
        </div>
      </section>

      <% related = @product.related %>
      <% if related.any? %>
        <h2 class="mt-10 mb-3 text-lg font-semibold text-gray-900">Related products</h2>
        <ul class="flex flex-wrap gap-2">
          <% related.each do |product| %>
            <li><%= link_to product.name, product_path(product), class: 'inline-block rounded-full border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:border-orange-500 hover:text-orange-700' %></li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <aside id="quote" class="scroll-mt-4 lg:sticky lg:top-4 lg:self-start">
      <%= render 'quote_form', product: @product, lead: @lead, quoted: %>
    </aside>
  </div>
</div>

<%= render 'layouts/footer' %>
