<%# After a lead form is sent: WhatsApp is often quicker than waiting for our
    call (email is off, docs/email.md). locals (optional): text (prefilled message) %>
<% text = local_assigns[:text] || 'Hi, I just sent a request on SigmaTenders.' %>
<div class="mt-5 rounded-lg border border-green-200 bg-green-50 p-4 text-left">
  <p class="text-sm font-semibold text-green-900">Quicker on WhatsApp?</p>
  <p class="mt-1 text-sm text-green-800">Send us the tender, or what you supply, and we'll reply there.</p>
  <a href="https://wa.me/918882301033?text=<%= ERB::Util.url_encode(text) %>" target="_blank" rel="noopener noreferrer"
     class="mt-3 inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700">
    <%= render 'tenders/whatsapp_icon' %> Message us on WhatsApp
  </a>
</div>
