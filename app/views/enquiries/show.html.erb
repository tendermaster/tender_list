<% sent = params[:sent].present? %>
<% set_meta_tags title: @topic.title, description: @topic.intro, canonical: enquiry_url(@topic.key),
                  robots: (@topic.index? && !sent && @lead.errors.none? ? nil : 'noindex, follow') %>
<%= render 'layouts/navbar' %>
<% input = 'mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-orange-500 focus:ring-orange-500' %>
<% label = 'block text-sm font-medium text-gray-900' %>
<% answered = @lead.answers %>

<div class="mx-auto w-full max-w-2xl px-4 py-10">
  <h1 class="text-2xl font-bold text-gray-900 md:text-3xl"><%= @topic.title %></h1>
  <p class="mt-2 text-gray-600"><%= @topic.intro %></p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
    <% if sent %>
      <h2 class="text-lg font-semibold text-gray-900">Thank you, we've received it</h2>
      <p class="mt-2 text-sm text-gray-600">Our team will get back to you, usually within one working day.</p>
      <%= link_to 'Back to SigmaTenders', root_path, class: 'mt-4 inline-block text-sm font-semibold text-orange-700 hover:underline' %>
    <% else %>
      <% if @lead.errors.any? %>
        <ul class="mb-4 list-inside list-disc rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-600" id="alert">
          <% @lead.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>

      <%= form_with model: @lead, url: enquiry_path(@topic.key), class: 'space-y-5', data: { turbo: false } do |f| %>
        <% @topic.fields.each do |field| %>
          <% name = "lead[answers][#{field.key}]" %>
          <% value = answered[field.label] %>
          <% required = field.required ? tag.span(' *', class: 'text-red-600', aria: { hidden: true }) : nil %>
          <% if field.choice? || field.checkboxes? %>
            <fieldset>
              <legend class="<%= label %>"><%= field.label %><%= required %></legend>
              <% if field.hint %><p class="text-xs text-gray-500"><%= field.hint %></p><% end %>
              <div class="mt-2 space-y-1.5">
                <% field.options.each_with_index do |option, index| %>
                  <label class="flex items-start gap-2 text-sm text-gray-700">
                    <% if field.checkboxes? %>
                      <%= check_box_tag "#{name}[]", option, Array(value).include?(option), id: "#{field.key}_#{index}",
                                        class: 'mt-0.5 rounded-sm border-gray-300 text-orange-600 focus:ring-orange-500' %>
                    <% else %>
                      <%= radio_button_tag name, option, value == option, id: "#{field.key}_#{index}", required: field.required,
                                           class: 'mt-0.5 border-gray-300 text-orange-600 focus:ring-orange-500' %>
                    <% end %>
                    <span><%= option %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% else %>
            <div>
              <%= label_tag "answer_#{field.key}", class: label do %><%= field.label %><%= required %><% end %>
              <% if field.hint %><p class="text-xs text-gray-500"><%= field.hint %></p><% end %>
              <% if field.type == 'paragraph' %>
                <%= text_area_tag name, value, id: "answer_#{field.key}", rows: 3, maxlength: 2000, required: field.required, class: input %>
              <% else %>
                <%= text_field_tag name, value, id: "answer_#{field.key}", maxlength: 200, required: field.required, class: input %>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <% if @topic.asks?('company') %>
          <div>
            <%= f.label :company, 'Company or organisation name', class: label %>
            <%= f.text_field :company, required: @topic.requires?('company'), maxlength: 120, autocomplete: 'organization', class: input %>
          </div>
        <% end %>
        <% if @topic.asks?('designation') %>
          <div>
            <%= label_tag :lead_designation, 'Your designation', class: label %>
            <%= text_field_tag 'lead[designation]', answered['Designation'], id: :lead_designation,
                               required: @topic.requires?('designation'), maxlength: 120, class: input %>
          </div>
        <% end %>
        <% if @topic.asks?('website') %>
          <div>
            <%= label_tag :lead_website, 'Website (optional)', class: label %>
            <%= url_field_tag 'lead[website]', answered['Website'], id: :lead_website, maxlength: 200,
                              placeholder: 'https://', class: input %>
          </div>
        <% end %>

        <%= render 'leads/contact_fields', f:, lead: @lead, input: %>

        <%= f.submit @topic.submit, class: 'btn-primary w-full sm:w-auto' %>
        <p class="text-xs text-gray-500">By sending this you agree that SigmaTenders may call, WhatsApp or email you about it. The information you give should be true and accurate.</p>
      <% end %>
    <% end %>
  </div>
</div>

<%= render 'layouts/footer' %>
