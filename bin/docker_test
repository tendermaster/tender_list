#!/usr/bin/env bash
# Run the Rails tests in throwaway containers: the app image against a fresh
# Postgres on a private network, so tests never touch the production database.
#   bin/docker_test                                  # all tests
#   bin/docker_test test/integration/google_sign_in_test.rb
set -euo pipefail
cd "$(dirname "$0")/.."

name="tender-list-test-$$"
docker network create "$name" >/dev/null
trap 'docker rm -f "$name-db" >/dev/null 2>&1; docker network rm "$name" >/dev/null' EXIT
docker run -d --name "$name-db" --network "$name" -e POSTGRES_PASSWORD=postgres postgres:16-alpine >/dev/null

docker run --rm --network "$name" -v "$PWD:/app" -w /app \
  -e RAILS_ENV=test -e SKIP_SIDEKIQ_CRON=1 -e OTEL_SDK_DISABLED=true -e AWS_EC2_METADATA_DISABLED=true \
  -e DATABASE_URL="postgres://postgres:postgres@$name-db/tender_list_test" \
  "${IMAGE:-sigmatenders-rails:latest}" sh -c '
    for i in $(seq 30); do bin/rails db:create >/dev/null 2>&1 && break; sleep 1; done
    bin/rails db:schema:load >/dev/null && bin/rails test "$@"' sh "$@"
