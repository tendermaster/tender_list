{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeadRequest",
  "description": "The lead fields of a quote request (POST /api/v1/leads). Generated from Lead validations by bin/rails marketplace:dump_lead_schema; do not edit.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "phone": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 120
    },
    "company": {
      "type": "string",
      "maxLength": 120
    },
    "quantity": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "location": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "needed_by": {
      "type": "string",
      "enum": [
        "Immediately",
        "Within a week",
        "Within a month",
        "Just comparing prices"
      ]
    },
    "details": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "name",
    "phone",
    "quantity",
    "location"
  ],
  "additionalProperties": false
}
